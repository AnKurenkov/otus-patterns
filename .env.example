# Пример конфигурации Space Battle.
# Скопируйте в .env и заполните значениями своего окружения.
# Префикс переменных: SPACE_BATTLE_.

# Секретный ключ для подписи JWT. Должен быть одинаковым на обоих сервисах.
# ВАЖНО: в продакшене всегда задавайте свой секрет, не используйте дефолт.
SPACE_BATTLE_SECRET_KEY=super_secret_key_for_space_battle_2026

# Алгоритм подписи JWT.
SPACE_BATTLE_ALGORITHM=HS256

# Game Service (порт по умолчанию 8001).
SPACE_BATTLE_GAME_SERVICE_HOST=0.0.0.0
SPACE_BATTLE_GAME_SERVICE_PORT=8001

# Auth Service (порт по умолчанию 8002).
SPACE_BATTLE_AUTH_SERVICE_HOST=0.0.0.0
SPACE_BATTLE_AUTH_SERVICE_PORT=8002

# Срок жизни JWT-токена в секундах (по умолчанию 3600).
SPACE_BATTLE_TOKEN_EXPIRATION_SECONDS=3600
